NODE_ENV=development
PORT=4000
AUTH_MODE=false
JWT_SECRET_KEY=secret-key

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USERNAME=task
POSTGRES_PASSWORD=task
POSTGRES_DATABASE=task

PGADMIN_DEFAULT_EMAIL=dockerpg@mail.com
PGADMIN_DEFAULT_PASSWORD=admin

DATABASE_URL="postgresql://${POSTGRES_USERNAME}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DATABASE}?schema=public"